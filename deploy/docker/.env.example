# mcsm container configuration.
# Copy to .env (kept out of git via .gitignore) and edit for your setup.
# Anything not set here uses sensible defaults; only MCSM_API_TOKEN is required.

# ---------- Identity ----------

# A short identifier for this MCSM instance. Must be unique across a
# federation. Lowercase letters, digits, and dashes; up to 64 chars.
MCSM_INSTANCE_NAME=mcsm-docker

# Where mcsm stores its audit log and runtime state.
# Mount a host path here in docker-compose if you want it to survive
# container recreation.
MCSM_DATA_DIR=/var/lib/mcsm

# ---------- API ----------

# host:port the API binds to inside the container.
MCSM_API_BIND=0.0.0.0:8124

# Bearer token in plaintext. Hashed (argon2id) at startup before being
# written to /etc/mcsm/config.yaml. Treat this like any production
# secret — store it in your secrets manager, not in version control.
# Generate one with:  openssl rand -hex 16
MCSM_API_TOKEN=replace-me-with-a-real-secret

# ---------- Discovery ----------

# Comma-separated list of parent directories that contain your MC
# server folders. Each subdirectory holding `.mcsm/config.yaml` is a
# discoverable server.
MCSM_DISCOVERY_ROOTS=/mnt/servers

# How often to rescan the discovery roots.
MCSM_DISCOVERY_INTERVAL=60s

# ---------- Slot ----------
# The container exposes one slot via env. For multi-slot setups, mount
# your own config.yaml at /etc/mcsm/config.yaml instead.

MCSM_SLOT_NAME=default
MCSM_SLOT_PORT=25565
# Public DNS name players use to connect (cosmetic; surfaced in the API).
MCSM_SLOT_PUBLIC_ADDRESS=
# Server UUID to mount on boot (leave blank to start unmounted).
MCSM_SLOT_AUTO_MOUNT=

# ---------- Logging ----------

MCSM_LOG_LEVEL=info       # debug | info | warn | error
MCSM_LOG_FORMAT=json      # json | text

# ---------- Audit ----------

MCSM_AUDIT_ENABLED=true
MCSM_AUDIT_RETENTION=720h

# ---------- Metrics ----------

MCSM_METRICS_ENABLED=true
# Require a token with `metrics:read` scope on /metrics. Default false
# (Prometheus typically lives in a private network).
MCSM_METRICS_REQUIRE_AUTH=false

# ---------- System ----------

# Path to a CPU temperature sensor file. Most LXC / unprivileged
# containers don't expose hardware sensors, so leave this blank.
# On bare-metal Linux, /sys/class/thermal/thermal_zone0/temp is typical.
MCSM_TEMP_SENSOR=
